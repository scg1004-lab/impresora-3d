# --- Impresora -------------------------------------------------------------
# IP de la AD5X. Es OPCIONAL y solo sirve para ir directo la primera vez:
# si el router le cambia la dirección, la app la reencuentra sola buscándola
# en la red y comprobando que el número de serie coincide.
PRINTER_IP=

# Número de serie y código de verificación: esto es lo que IDENTIFICA a tu
# impresora, y lo que de verdad hace falta. Ambos salen en su pantalla, en la
# de conexión LAN.
PRINTER_SERIAL=
PRINTER_CHECK_CODE=

# Puerto de la API HTTP local. 8898 salvo que Flashforge lo cambie.
PRINTER_PORT=8898

# Nivelar la cama antes de cada impresión lanzada desde aquí.
LEVELING_BEFORE_PRINT=false

# --- Laminador -------------------------------------------------------------
# Solo si Orca no está en la ruta habitual. Tiene que ser el binario de CONSOLA.
# SLICER_EXE=C:\Program Files\OrcaSlicer\orca-slicer-console.exe

# --- Buscar modelos en internet -------------------------------------------
# Token de Thingiverse, para buscar modelos desde la propia app. Se saca
# registrando una aplicacion (tipo Desktop) en thingiverse.com/apps/create.
# Sin esto la app funciona igual; solo no aparece el buscador.
THINGIVERSE_TOKEN=
